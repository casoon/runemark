---
import { readFile } from 'node:fs/promises';
import { join, resolve } from 'node:path';
import {
  Badge,
  Badges,
  BuildOutput,
  CallToAction,
  CodeBlock,
  Facts,
  Faq,
  Features,
  Hero,
  Install,
  Quickstart,
  ReleaseHighlights,
  Spotlight,
  Terminal,
} from '@casoon/pages-theme/components';
import Base from '@casoon/pages-theme/layouts/Base.astro';
import config from 'virtual:casoon-pages/config';
import { parseChangelog } from '@casoon/pages-theme/lib/changelog';
import { url } from '@casoon/pages-theme/url';
import heroCast from '../../../assets/hero.svg';
import { ansi } from '../showcase';

// Skip "Unreleased": it has no version to show as "New in v…" yet.
const latestRelease = config.changelog
  ? parseChangelog(await readFile(config.changelog, 'utf8')).find(
      (r) => r.version.toLowerCase() !== 'unreleased'
    )
  : undefined;

// The facts below come from the manifests, so they cannot drift from the release.
const repoRoot = resolve(process.cwd(), '..');
const rustVersion = (await readFile(join(repoRoot, 'Cargo.toml'), 'utf8')).match(
  /^rust-version\s*=\s*"([^"]+)"/m
)?.[1];
if (!rustVersion) throw new Error('Cargo.toml has no rust-version');
const nodePackage = JSON.parse(
  await readFile(join(repoRoot, 'packages/runemark/package.json'), 'utf8')
);
const nodeVersion = nodePackage.engines.node.replace(/\D/g, '');
const nodePlatforms = nodePackage.napi.targets.length;

const rust = `use runemark::{ColorMode, Console, Tone, Verdict};

let console = Console::stdout(ColorMode::Auto);

println!("{}", console.paint(Tone::Title, "site audit"));
println!("{}", Verdict::Warning.render(console, "3 findings need review"));
println!("{}", console.paint(Tone::Muted, "Run with --details for every finding."));`;

const node = `const { RunemarkConsole, renderReport } = require('@casoon/runemark')

const console = new RunemarkConsole({ color: 'auto' })
console.writeWarning('3 findings need review')

process.stdout.write(renderReport({
  schemaVersion: 1,
  title: 'Site audit',
  verdict: 'warning',
}, { width: process.stdout.columns }))`;
---

<Base>
  <Hero
    title="One way for your CLI tools to talk."
    lead="runemark renders status lines, reports, error blocks and file-change previews with one colour policy: TTY-aware, NO_COLOR-compliant, plain when redirected. The crate and the npm package share the same Rust renderer."
  >
    <Install
      commands={[
        { label: 'cargo', command: 'cargo add runemark' },
        { label: 'npm', command: 'npm install @casoon/runemark' },
      ]}
    />
    <Badges>
      <Badge>MIT</Badge>
      <Badge>crates.io</Badge>
      <Badge>npm</Badge>
      <Badge>Rust {rustVersion}+</Badge>
      <Badge>Node {nodeVersion}+</Badge>
    </Badges>
    <img
      slot="output"
      class="hero-demo"
      src={heroCast.src}
      width={heroCast.width}
      height={heroCast.height}
      alt="A terminal running cargo run --example hero_demo --features progress: a progress bar fills as four pages are audited, then a site audit report appears with its metrics, two accessibility findings and a next step."
    />
  </Hero>

  <Facts
    items={[
      { value: '1', label: 'required dependency (unicode-width)' },
      { value: String(nodePlatforms), label: 'prebuilt Node platforms' },
      { value: rustVersion, label: 'minimum Rust version' },
      { value: '2', label: 'ecosystems, one renderer' },
    ]}
  />

  <Features
    items={[
      {
        title: 'Semantic, not cosmetic',
        body: 'Callers say what a line means – success, warning, error, a verdict, a finding. runemark decides how it looks, so related tools read the same.',
      },
      {
        title: 'Predictable colour policy',
        body: 'Auto emits styles only to an interactive terminal, honours NO_COLOR and stays plain for TERM=dumb; Always and Never are explicit. Colour, symbols and hyperlinks can each be set on their own. Redirected output stays plain and deterministic.',
      },
      {
        title: 'Reports that fit the terminal',
        body: 'Compact or detailed, with metrics, grouped findings and next steps. Given a width, narrow layouts stack metrics and wrap messages with a hanging indent.',
      },
      {
        title: 'Menus when a prompt is not enough',
        body: 'An optional grouped menu with filtering, tabs and multi-pick for Unix terminals. It redraws on resize, never blocks without a terminal, and hands you a plain rendering to print instead.',
      },
      {
        title: 'Safe with untrusted text',
        body: 'Control characters in messages, paths and URLs are neutralised; hyperlinks are only emitted for http and https URLs and for file paths the tool resolves itself.',
      },
    ]}
  />

  <Spotlight
    eyebrow="How it renders"
    title="One report, any width"
    lead="**Reports adapt to the terminal they're given, not to a fixed layout.** Pass a known width and narrow terminals stack summary metrics and wrap finding messages with a hanging indent instead of truncating."
    points={[
      "**Verdict symbols survive NO_COLOR.** A tone disappears without color; the verdict's own symbol does not — a failing metric still reads as failing piped to a file.",
      '**Compact or detailed, same data.** The host CLI chooses `detailLevel`; runemark never asks for two separate report shapes. Compact output says how many findings it left out, and your tool words the pointer to the rest.',
      '**Determinism by construction.** Identical input always walks the same path — no timing-dependent output, so fixtures can be committed and diffed.',
    ]}
    links={[
      { label: 'Reports guide', href: url('docs/guides/reports/') },
      { label: 'Colour policy', href: url('docs/guides/colour-policy/') },
    ]}
  >
    <Terminal title="44 columns" dots ansi={ansi['report-narrow']} />
  </Spotlight>

  <BuildOutput
    caption="These terminals and the ones in the showcase are rendered by @casoon/runemark during the build – the same renderer as the crate. Only the animation at the top is a recording, of the hero_demo example."
    file="site/src/showcase.ts"
  >
    <Terminal ansi={ansi['report-detailed']} />
  </BuildOutput>

  <Quickstart
    lead="Three steps from install to consistent output. The full walkthrough lives in the documentation."
    steps={[
      'Add the crate or the npm package to your command-line tool.',
      'Pick a colour mode – <code>Auto</code> is right for most tools.',
      'Pass your own data to semantic lines, reports, error blocks or diffs.',
    ]}
  >
    <CodeBlock code={rust} lang="rust" title="main.rs" label="Rust" />
    <CodeBlock code={node} lang="js" title="audit.cjs" label="Node" />
  </Quickstart>

  {latestRelease && <ReleaseHighlights release={latestRelease} />}

  <Faq
    items={[
      {
        q: 'Do the Rust crate and the Node package produce identical output?',
        a: 'Yes. The npm package wraps the same Rust renderer through a native addon — there is one presentation layer, not a port kept in sync by hand.',
      },
      {
        q: 'Does runemark work on Windows?',
        a: 'Semantic output, color policy, reports and progress do. The optional select menu talks to the terminal directly through termios and is Unix-only — on Windows it reports Outcome::Unavailable and the caller falls back to render().',
      },
      {
        q: 'What does output look like under NO_COLOR or when piped to a file?',
        a: "Plain and deterministic. Tones disappear, but a verdict's own symbol stays, so a failing metric still reads as failing without color.",
      },
      {
        q: 'How do I test the output of my CLI?',
        a: 'Render with ColorMode::Never for deterministic text, or strip the escape sequences from a coloured string with strip_ansi. assert_plain_snapshot! compares the plain result against an expected block, and the Node package renders the same bytes.',
      },
      {
        q: 'Can I turn off symbols or hyperlinks without turning off colour?',
        a: 'Yes. Colour, the symbol set and OSC 8 hyperlinks follow one decision by default and can each be overridden: Console::with_theme chooses Unicode or ASCII symbols, Console::with_hyperlinks switches links.',
      },
      {
        q: 'Does runemark parse my CLI arguments or define my report data?',
        a: 'No. It owns terminal presentation only — color policy, layout, semantic tones. Argument parsing, configuration, domain finding types and output formats like JSON or SARIF stay yours.',
      },
    ]}
  />

  <CallToAction
    title="Consistent CLI output in three steps."
    href={url('docs/getting-started/quickstart/')}
    label="Read the quickstart"
  />
</Base>

<style>
  .hero-demo {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 10px;
  }
</style>
