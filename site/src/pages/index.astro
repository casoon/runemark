---
import { readFile } from 'node:fs/promises';
import { join, resolve } from 'node:path';
import {
  Badge,
  Badges,
  CallToAction,
  CodeBlock,
  Faq,
  Features,
  Flow,
  Hero,
  Install,
  Integrations,
  Quickstart,
  ReleaseHighlights,
  Spotlight,
  StatBand,
  Terminal,
  Tour,
} from '@casoon/pages-theme/components';
import Base from '@casoon/pages-theme/layouts/Base.astro';
import config from 'virtual:casoon-pages/config';
import { parseChangelog } from '@casoon/pages-theme/lib/changelog';
import { url } from '@casoon/pages-theme/url';
import heroCast from '../../../assets/hero.svg';
import { ansi } from '../showcase';

// Skip "Unreleased": it has no version to show as "New in v…" yet.
const latestRelease = config.changelog
  ? parseChangelog(await readFile(config.changelog, 'utf8')).find(
      (r) => r.version.toLowerCase() !== 'unreleased'
    )
  : undefined;

// The facts below come from the manifests, so they cannot drift from the release.
const repoRoot = resolve(process.cwd(), '..');
const rustVersion = (await readFile(join(repoRoot, 'Cargo.toml'), 'utf8')).match(
  /^rust-version\s*=\s*"([^"]+)"/m
)?.[1];
if (!rustVersion) throw new Error('Cargo.toml has no rust-version');
const nodePackage = JSON.parse(
  await readFile(join(repoRoot, 'packages/runemark/package.json'), 'utf8')
);
const nodeVersion = nodePackage.engines.node.replace(/\D/g, '');
const nodePlatforms = nodePackage.napi.targets.length;

const rust = `use runemark::{ColorMode, Console, Tone, Verdict};

let console = Console::stdout(ColorMode::Auto);

println!("{}", console.paint(Tone::Title, "site audit"));
println!("{}", Verdict::Warning.render(console, "3 findings need review"));
println!("{}", console.paint(Tone::Muted, "Run with --details for every finding."));`;

const node = `const { RunemarkConsole, renderReport } = require('@casoon/runemark')

const console = new RunemarkConsole({ color: 'auto' })
console.writeWarning('3 findings need review')

process.stdout.write(renderReport({
  schemaVersion: 1,
  title: 'Site audit',
  verdict: 'warning',
}, { width: process.stdout.columns }))`;
---

<Base>
  <Hero
    title="One way for your CLI tools to talk."
    lead="runemark renders status lines, reports, error blocks and file-change previews with one colour policy: TTY-aware, NO_COLOR-compliant, plain when redirected. The crate and the npm package share the same Rust renderer."
  >
    <Install
      commands={[
        { label: 'cargo', command: 'cargo add runemark' },
        { label: 'npm', command: 'npm install @casoon/runemark' },
      ]}
    />
    <Badges>
      <Badge>MIT</Badge>
      <Badge>crates.io {config.version}</Badge>
      <Badge>Rust {rustVersion}+</Badge>
      <Badge>Node {nodeVersion}+</Badge>
    </Badges>
    <img
      slot="output"
      class="hero-demo"
      src={heroCast.src}
      width={heroCast.width}
      height={heroCast.height}
      alt="A terminal running cargo run --example hero_demo --features progress: a progress bar fills as four pages are audited, then a site audit report appears with its metrics, two accessibility findings and a next step."
    />
  </Hero>

  <StatBand
    items={[
      { value: '1', label: 'required dependency (unicode-width)' },
      { value: String(nodePlatforms), label: 'prebuilt Node platforms' },
      { value: rustVersion, label: 'minimum Rust version' },
      { value: '2', label: 'ecosystems, one renderer' },
    ]}
  />

  <Tour
    id="shapes"
    eyebrow="What it renders"
    title="Say what a line means. runemark draws it."
    lead="Four shapes cover what a command-line tool reports back. **Every terminal on this page is rendered by @casoon/runemark during the build** – the same Rust code as the crate, not a screenshot."
    steps={[
      {
        title: 'Status lines',
        body: 'Six verdicts, each with its own symbol and tone: passed, warning, failed, action required, skipped, info.',
      },
      {
        title: 'Reports',
        body: 'A verdict, summary metrics with trends, grouped findings with locations, and next steps. Compact by default.',
      },
      {
        title: 'Error blocks',
        body: 'What went wrong, why, and the command that fixes it – instead of a bare error string.',
      },
      {
        title: 'File changes',
        body: 'Added, modified, renamed and deleted files as a preview, before or after your tool writes them.',
      },
    ]}
    link={{ label: 'All examples', href: url('showcase/') }}
  >
    <div slot="step-1"><Terminal title="status" dots ansi={ansi.verdicts} /></div>
    <div slot="step-2"><Terminal title="report" dots ansi={ansi['report-compact']} /></div>
    <div slot="step-3"><Terminal title="error" dots ansi={ansi['error-block']} /></div>
    <div slot="step-4"><Terminal title="diff" dots ansi={ansi['file-changes']} /></div>
  </Tour>

  <Flow
    eyebrow="How it works"
    title="Your data in, the right output out"
    lead="runemark sits between your tool's own types and the stream it writes to. It decides how a line looks – never what it says."
    stages={[
      {
        label: 'Input',
        artifact: 'Report::new(…)',
        title: 'Your data',
        body: 'Findings, metrics and next steps come from your own types. runemark defines no domain model.',
      },
      {
        label: 'Decide',
        artifact: 'ColorMode::Auto',
        title: 'One policy',
        body: 'The console checks for a terminal, `NO_COLOR` and `TERM=dumb`, then sets colour, symbols and links.',
      },
      {
        label: 'Render',
        artifact: 'crate · napi',
        title: 'One renderer',
        body: 'The Rust crate and the npm package call the same code, so their bytes match.',
      },
      {
        label: 'Output',
        artifact: 'stdout · stderr',
        title: 'Any destination',
        body: 'Styled in a terminal, plain and deterministic in a pipe, a log or a snapshot test.',
      },
    ]}
  />

  <Spotlight
    eyebrow="Colour policy"
    title="Same call, every destination"
    lead="**Colour is a property of the destination, not of the message.** `Auto` styles output only for an interactive terminal; piped, under `NO_COLOR` or with `TERM=dumb` the same call writes plain text."
    points={[
      "**Verdict symbols survive without colour.** A failure still reads as a failure in a CI log – ASCII marks replace the Unicode ones.",
      '**Colour, symbols and hyperlinks** follow one decision by default and can each be overridden.',
      '**Deterministic by construction.** Identical input always gives identical bytes, so output can be committed as a fixture and diffed.',
    ]}
    links={[
      { label: 'Colour policy', href: url('docs/guides/colour-policy/') },
      { label: 'Testing', href: url('docs/guides/testing/') },
    ]}
  >
    <div class="pair">
      <Terminal title="terminal" dots ansi={ansi['error-block']} />
      <Terminal title="| cat" dots ansi={ansi['error-block-plain']} />
    </div>
  </Spotlight>

  <Spotlight
    reverse
    eyebrow="Adaptive layout"
    title="One report, any width"
    lead="**Reports adapt to the terminal they're given, not to a fixed layout.** Pass a known width and narrow terminals stack summary metrics and wrap finding messages with a hanging indent instead of truncating."
    points={[
      '**Compact or detailed, same data.** The host CLI chooses the detail level; compact output says how many findings it left out, and your tool words the pointer to the rest.',
      '**No terminal access needed.** Your tool passes the width it knows; runemark never queries the terminal behind your back.',
    ]}
    links={[{ label: 'Reports guide', href: url('docs/guides/reports/') }]}
  >
    <Terminal title="44 columns" dots ansi={ansi['report-narrow']} />
  </Spotlight>

  <Features
    layout="grid"
    heading="Built for tools other people run"
    items={[
      {
        icon: 'S',
        title: 'Semantic, not cosmetic',
        body: 'Callers say what a line means – success, warning, error, a verdict, a finding. runemark decides how it looks, so related tools read the same.',
      },
      {
        icon: 'P',
        title: 'Progress that stays out of pipes',
        body: 'A live bar on an interactive terminal, a compact line-oriented lifecycle everywhere else, so machine-readable stdout stays clean.',
      },
      {
        icon: 'M',
        title: 'Menus when a prompt is not enough',
        body: 'An optional grouped menu with filtering, tabs and multi-pick for Unix terminals. It redraws on resize and never blocks without a terminal.',
      },
      {
        icon: 'T',
        title: 'Golden tests in a few lines',
        body: 'Renderers write to any writer; strip_ansi and assert_plain_snapshot! compare plain output against an expected block.',
      },
      {
        icon: 'L',
        title: 'Locations you can click',
        body: 'File paths with line and column, and URLs, become OSC 8 hyperlinks in terminals that support them – and plain text everywhere else.',
      },
      {
        icon: '!',
        title: 'Safe with untrusted text',
        body: 'Control characters in messages, paths and URLs are neutralised; hyperlinks are only emitted for http and https URLs and for file paths the tool resolves itself.',
      },
    ]}
  />

  <Integrations
    heading="Where it runs"
    items={[
      { icon: 'rs', name: 'Rust crate', category: `crates.io · Rust ${rustVersion}+`, href: 'https://crates.io/crates/runemark' },
      { icon: 'npm', name: 'Node package', category: `npm · Node ${nodeVersion}+ · types included`, href: 'https://www.npmjs.com/package/@casoon/runemark' },
      { icon: 'mac', name: 'macOS', category: 'Apple silicon · prebuilt' },
      { icon: 'lnx', name: 'Linux', category: 'x64 and arm64, glibc and musl · prebuilt' },
      { icon: 'win', name: 'Windows', category: 'x64 · prebuilt; the menu is Unix-only' },
    ]}
  />

  <Quickstart
    lead="Three steps from install to consistent output. The full walkthrough lives in the documentation."
    steps={[
      'Add the crate or the npm package to your command-line tool.',
      'Pick a colour mode – <code>Auto</code> is right for most tools.',
      'Pass your own data to semantic lines, reports, error blocks or diffs.',
    ]}
  >
    <CodeBlock code={rust} lang="rust" title="main.rs" label="Rust" />
    <CodeBlock code={node} lang="js" title="audit.cjs" label="Node" />
  </Quickstart>

  {latestRelease && <ReleaseHighlights release={latestRelease} />}

  <Faq
    items={[
      {
        q: 'Do the Rust crate and the Node package produce identical output?',
        a: 'Yes. The npm package wraps the same Rust renderer through a native addon — there is one presentation layer, not a port kept in sync by hand.',
      },
      {
        q: 'Does runemark work on Windows?',
        a: 'Semantic output, color policy, reports and progress do. The optional select menu talks to the terminal directly through termios and is Unix-only — on Windows it reports Outcome::Unavailable and the caller falls back to render().',
      },
      {
        q: 'How do I test the output of my CLI?',
        a: 'Render with ColorMode::Never for deterministic text, or strip the escape sequences from a coloured string with strip_ansi. assert_plain_snapshot! compares the plain result against an expected block, and the Node package renders the same bytes.',
      },
      {
        q: 'Does runemark parse my CLI arguments or define my report data?',
        a: 'No. It owns terminal presentation only — color policy, layout, semantic tones. Argument parsing, configuration, domain finding types and output formats like JSON or SARIF stay yours.',
      },
    ]}
  />

  <CallToAction
    title="Consistent CLI output in three steps."
    href={url('docs/getting-started/quickstart/')}
    label="Read the quickstart"
  />
</Base>

<style>
  .hero-demo {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 10px;
  }
  .pair {
    display: grid;
    gap: 16px;
  }
  /* Links inside changelog entries need more than colour to stand out from the text. */
  :global(.release-highlights li a) {
    text-decoration: underline;
    text-underline-offset: 2px;
  }
</style>
